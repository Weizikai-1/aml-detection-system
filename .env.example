# ===== DeepSeek API 配置 =====
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=在这里填入你的DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== JWT 认证配置 =====
# 生产环境必须设置，否则每次启动会随机生成（旧token失效）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===== 加密密钥 =====
# 用于加密API密钥等敏感数据，生产环境必须设置
ENCRYPT_KEY=

# ===== 数据库配置（可选，不配置则使用JSON文件模式） =====
# DATABASE_URL=postgresql://aml_user:your_password@localhost:5432/aml_db
POSTGRES_DB=aml_db
POSTGRES_USER=aml_user
POSTGRES_PASSWORD=

# ===== Redis 配置（可选，不配置则不使用Celery异步任务） =====
# REDIS_URL=redis://:your_password@localhost:6379/0
REDIS_PASSWORD=

# ===== 应用配置 =====
# development / production
APP_ENV=development
LOG_LEVEL=INFO

# CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost:8501,http://localhost:8000

# ===== 开发环境用户密码（仅开发模式，生产环境使用数据库） =====
DEV_ADMIN_PASSWORD=
DEV_ANALYST_PASSWORD=

# ===== HTTPS/SSL 配置 =====
# SSL证书路径（部署到deploy/nginx/ssl目录）
# 生成自签名证书（开发测试用）:
#   openssl req -x509 -newkey rsa:4096 -keyout deploy/nginx/ssl/key.pem -out deploy/nginx/ssl/cert.pem -days 365 -nodes
# 生产环境请使用正式CA签发证书
SSL_CERT_PATH=deploy/nginx/ssl/cert.pem
SSL_KEY_PATH=deploy/nginx/ssl/key.pem
